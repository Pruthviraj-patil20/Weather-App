# ─────────────────────────────────────────────────────────────
# SKYCAST — Environment configuration
# Copy this file to `.env` and fill in your credentials.
# ─────────────────────────────────────────────────────────────

# OpenWeatherMap API key (https://home.openweathermap.org/api_keys)
# One key works for current weather, forecast, air pollution & geocoding.
WEATHER_API_KEY=

# Base URL for the OpenWeatherMap API (leave default unless self-hosting a proxy)
WEATHER_API_URL=https://api.openweathermap.org

# Extended daily forecast (OpenWeatherMap One Call 3.0, requires a paid
# subscription) is attempted by default and gives the full 7-day view.
# Set to 0 to disable it and always use the free "5 day / 3 hour" endpoint,
# which the app falls back to automatically when extended data is unavailable.
WEATHER_API_EXTENDED=0

# Default language code for API responses (en, de, fr, es, ru, ...)
WEATHER_API_LANG=en
